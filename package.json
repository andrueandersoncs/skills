{
  "name": "skills",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --workspaces build",
    "test": "bun run skills:check && bun run --workspaces test && bun test ./evals/skills",
    "skills:sync": "bun scripts/sync-skills.ts sync",
    "skills:check": "bun scripts/sync-skills.ts check",
    "eval:skills": "bun scripts/evaluate-skills.ts",
    "compile:skill": "bun scripts/compile-skill.ts",
    "lint:bts": "better-typescript"
  },
  "devDependencies": {
    "@better-typescript/better-typescript": "^0.4.13",
    "@types/bun": "latest"
  }
}
