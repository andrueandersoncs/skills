{
  "name": "@andrue/cli",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "CLI for manage-project, LLM wiki operations, and Effect Schema sample generation",
  "license": "MIT",
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "bin": {
    "andrue-cli": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun test ./test"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "tsup": "latest",
    "typescript": "latest"
  }
}
